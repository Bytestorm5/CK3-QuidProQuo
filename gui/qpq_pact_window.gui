						default_format = "#weak"
					}
				}

				vbox = {
					visible = "[GetVariableSystem.HasValue( 'qpq_popup', 'artifact_them' )]"
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					spacing = 4

					background = {
						using = Background_Area_Dark
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_ARTIFACT_CHOSEN"
						default_format = "#T"
						using = Font_Size_Medium
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_gift_artifact')]"

						item = {
							button_standard_list = {
								layoutpolicy_horizontal = expanding
								size = { 0 34 }
								down = yes
								text = "[Scope.Artifact.GetName]"
								onclick = "[GetScriptedGui('qpq_ui_artifact_toggle_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Scope.Artifact.MakeScope ).End )]"
							}
						}
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_ARTIFACT_AVAILABLE"
						default_format = "#T"
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_gift_artifact_candidates')]"

						item = {
							button_standard_list = {
								layoutpolicy_horizontal = expanding
								size = { 0 34 }
								text = "[Scope.Artifact.GetName]"
								onclick = "[GetScriptedGui('qpq_ui_artifact_toggle_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Scope.Artifact.MakeScope ).End )]"
							}
						}
					}
					text_single = {
						visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('qpq_ui_i_gift_artifact_candidates') )]"
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_ARTIFACT_NONE"
						default_format = "#weak"
					}
				}

				vbox = {
					visible = "[GetVariableSystem.HasValue( 'qpq_popup', 'secret_them' )]"
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					spacing = 4

					background = {
						using = Background_Area_Dark
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_SECRET_CHOSEN"
						default_format = "#T"
						using = Font_Size_Medium
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_gift_secret')]"

						item = {
							button_standard_list = {
								layoutpolicy_horizontal = expanding
								size = { 0 34 }
								down = yes
								text = "[Scope.Char.GetUINameNoTooltip]"
								onclick = "[GetScriptedGui('qpq_ui_secret_toggle_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Scope.Char.MakeScope ).End )]"
							}
						}
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_SECRET_AVAILABLE"
						default_format = "#T"
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_gift_secret_candidates')]"

						item = {
							button_standard_list = {
								layoutpolicy_horizontal = expanding
								size = { 0 34 }
								text = "[Scope.Char.GetUINameNoTooltip]"
								onclick = "[GetScriptedGui('qpq_ui_secret_toggle_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Scope.Char.MakeScope ).End )]"
							}
						}
					}
					text_single = {
						visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList('qpq_ui_i_gift_secret_candidates') )]"
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_SECRET_NONE"
						default_format = "#weak"
					}
				}

				}
			}
		}

		button_primary = {
			layoutpolicy_horizontal = expanding
			size = { 0 44 }
			text = "QPQ_UI_DONE"
			onclick = "[GetVariableSystem.Clear( 'qpq_popup' )]"
		}
	}
}
