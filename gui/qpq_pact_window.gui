						enabled = "[GetScriptedGui('qpq_ui_kind_t_bought_freedom').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						tooltip = "[Select_CString( GetScriptedGui('qpq_ui_kind_t_bought_freedom').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ), Localize( 'qpq_bought_freedom_hub_tt' ), GetScriptedGui('qpq_ui_kind_t_bought_freedom').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ) )]"
						using = tooltip_ne
						onclick = "[GetScriptedGui('qpq_ui_kind_t_bought_freedom').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Set( 'qpq_popup', 'deed_them' )]"
						down = "[EqualTo_string( GetPlayer.MakeScope.Var('qpq_ui_t_kind').GetFlagName, 'bought_freedom' )]"
					}

					button_standard_list = {
						visible = "[GetScriptedGui('qpq_ui_kind_t_accept_the_yoke').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						size = { 0 32 }
						text = "qpq_accept_the_yoke_name"
						enabled = "[GetScriptedGui('qpq_ui_kind_t_accept_the_yoke').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						tooltip = "[Select_CString( GetScriptedGui('qpq_ui_kind_t_accept_the_yoke').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ), Localize( 'qpq_accept_the_yoke_hub_tt' ), GetScriptedGui('qpq_ui_kind_t_accept_the_yoke').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ) )]"
						using = tooltip_ne
						onclick = "[GetScriptedGui('qpq_ui_kind_t_accept_the_yoke').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Set( 'qpq_popup', 'deed_them' )]"
						down = "[EqualTo_string( GetPlayer.MakeScope.Var('qpq_ui_t_kind').GetFlagName, 'accept_the_yoke' )]"
					}

					button_standard_list = {
						visible = "[GetScriptedGui('qpq_ui_kind_t_cast_off_the_yoke').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						size = { 0 32 }
						text = "qpq_cast_off_the_yoke_name"
						enabled = "[GetScriptedGui('qpq_ui_kind_t_cast_off_the_yoke').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						tooltip = "[Select_CString( GetScriptedGui('qpq_ui_kind_t_cast_off_the_yoke').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ), Localize( 'qpq_cast_off_the_yoke_hub_tt' ), GetScriptedGui('qpq_ui_kind_t_cast_off_the_yoke').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ) )]"
						using = tooltip_ne
						onclick = "[GetScriptedGui('qpq_ui_kind_t_cast_off_the_yoke').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Set( 'qpq_popup', 'deed_them' )]"
						down = "[EqualTo_string( GetPlayer.MakeScope.Var('qpq_ui_t_kind').GetFlagName, 'cast_off_the_yoke' )]"
					}

					text_single = {
						visible = "[GetScriptedGui('qpq_ui_group_t_wartime').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						margin = { 6 4 }
						text = "qpq_hub.group.wartime"
						default_format = "#T"
						using = Font_Size_Medium
					}

					button_standard_list = {
						visible = "[GetScriptedGui('qpq_ui_kind_t_join_war').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						size = { 0 32 }
						text = "qpq_join_war_name"
						enabled = "[GetScriptedGui('qpq_ui_kind_t_join_war').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						tooltip = "[Select_CString( GetScriptedGui('qpq_ui_kind_t_join_war').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ), Localize( 'qpq_join_war_hub_tt' ), GetScriptedGui('qpq_ui_kind_t_join_war').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ) )]"
						using = tooltip_ne
						onclick = "[GetScriptedGui('qpq_ui_kind_t_join_war').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Set( 'qpq_popup', 'deed_them' )]"
						down = "[EqualTo_string( GetPlayer.MakeScope.Var('qpq_ui_t_kind').GetFlagName, 'join_war' )]"
					}

					button_standard_list = {
						visible = "[GetScriptedGui('qpq_ui_kind_t_stay_out').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						size = { 0 32 }
						text = "qpq_stay_out_name"
						enabled = "[GetScriptedGui('qpq_ui_kind_t_stay_out').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						tooltip = "[Select_CString( GetScriptedGui('qpq_ui_kind_t_stay_out').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ), Localize( 'qpq_stay_out_hub_tt' ), GetScriptedGui('qpq_ui_kind_t_stay_out').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End ) )]"
						using = tooltip_ne
						onclick = "[GetScriptedGui('qpq_ui_kind_t_stay_out').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Set( 'qpq_popup', 'deed_them' )]"
						down = "[EqualTo_string( GetPlayer.MakeScope.Var('qpq_ui_t_kind').GetFlagName, 'stay_out' )]"
					}

					}
				}
			}

			}
		}

		############ FOOTER ############
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 8 }
			spacing = 10

			background = {
				using = Background_Area_Dark
			}

			button_standard = {
				size = { 160 44 }
				text = "QPQ_UI_CANCEL"
				onclick = "[GetVariableSystem.Clear( 'qpq_popup' )]"
				onclick = "[GetScriptedGui('qpq_ui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			expand = {}

			button_primary = {
				size = { 260 44 }
				text = "QPQ_UI_PROPOSE"
				enabled = "[GetScriptedGui('qpq_ui_propose').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
				tooltip = "[GetScriptedGui('qpq_ui_propose').BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
				onclick = "[GetScriptedGui('qpq_ui_propose').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
			}
		}
	}
}

######################################################
# The pop-out for anything that needs configuring: a deed's target and terms, gold's timing, the titles to hand over
######################################################
window = {
	name = "qpq_config_window"
	parentanchor = center
	position = { 0 0 }
	allow_outside = yes
	layer = top
	movable = yes
	size = { 560 720 }
	datacontext = "[GetPlayer]"

	visible = "[And( GetVariableSystem.Exists( 'qpq_popup' ), And( Or( Not( GetVariableSystem.HasValue( 'qpq_popup', 'deed_me' ) ), GetScriptedGui('qpq_ui_config_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), Or( Not( GetVariableSystem.HasValue( 'qpq_popup', 'deed_them' ) ), GetScriptedGui('qpq_ui_config_t').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"

	using = Window_Background
	using = Window_Decoration_Spike

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	vbox = {
		using = Window_Margins
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 6

		header_pattern_interaction = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "QPQ_UI_CONFIG_TITLE"
			}

			blockoverride "button_close" {
				onclick = "[GetVariableSystem.Clear( 'qpq_popup' )]"
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			size = { 520 500 }

			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6

				vbox = {
					visible = "[GetVariableSystem.HasValue( 'qpq_popup', 'deed_me' )]"
					layoutpolicy_horizontal = expanding
					spacing = 6

					vbox = {
						visible = "[Not( EqualTo_string( GetPlayer.MakeScope.Var('qpq_ui_i_kind').GetFlagName, 'none' ) )]"
						layoutpolicy_horizontal = expanding
						margin = { 10 8 }
						spacing = 4

						background = {
							using = Background_Area_Dark
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "[GetPlayer.Custom('QpqUiKindName_i')]"
							default_format = "#T"
							using = Font_Size_Medium
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 480
							autoresize = yes
							text = "[GetPlayer.Custom('QpqUiKindDesc_i')]"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 480
							autoresize = yes
							default_format = "#weak"
							text = "QPQ_UI_HINT_LINE_I"
						}
					}

					vbox = {
						visible = "[GetScriptedGui('qpq_ui_term_shown_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						margin = { 10 8 }
						spacing = 4

						background = {
							using = Background_Area_Dark
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "QPQ_UI_TERM_HEADER"
							default_format = "#T"
						}
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4

							button_standard_list = {
								size = { 52 30 }
								text = "-5"
								onclick = "[GetScriptedGui('qpq_ui_term_down_i_5').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('qpq_ui_term_down_i_5').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								tooltip = "QPQ_UI_TERM_STEP_TT"
							}

							button_standard_list = {
								size = { 52 30 }
								text = "-1"
								onclick = "[GetScriptedGui('qpq_ui_term_down_i_1').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('qpq_ui_term_down_i_1').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								tooltip = "QPQ_UI_TERM_STEP_TT"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								align = center|nobaseline
								text = "[GetPlayer.Custom('QpqUiTermLine_i')]"
								using = Font_Size_Medium
							}

							button_standard_list = {
								size = { 52 30 }
								text = "+1"
								onclick = "[GetScriptedGui('qpq_ui_term_up_i_1').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('qpq_ui_term_up_i_1').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								tooltip = "QPQ_UI_TERM_STEP_TT"
							}

							button_standard_list = {
								size = { 52 30 }
								text = "+5"
								onclick = "[GetScriptedGui('qpq_ui_term_up_i_5').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('qpq_ui_term_up_i_5').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								tooltip = "QPQ_UI_TERM_STEP_TT"
							}

						}
						button_standard_list = {
							layoutpolicy_horizontal = expanding
							size = { 0 30 }
							text = "QPQ_UI_TERM_USUAL"
							visible = "[GetScriptedGui('qpq_ui_term_usual_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetScriptedGui('qpq_ui_term_usual_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "QPQ_UI_TERM_USUAL_TT"
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							align = center|nobaseline
							visible = "[Not( GetScriptedGui('qpq_ui_term_usual_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
							text = "QPQ_UI_TERM_IS_USUAL"
							default_format = "#weak"
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 480
							autoresize = yes
							default_format = "#weak"
							text = "[GetPlayer.Custom('QpqUiTermInfo_i')]"
						}
					}

					text_single = {
						visible = "[GetScriptedGui('qpq_ui_needs_any_target_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						margin_left = 6
						text = "QPQ_UI_PICK_TARGET"
						default_format = "#T"
					}
					vbox = {
						visible = "[GetScriptedGui('qpq_ui_needs_char_target_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_candidates')]"

						item = {
							potential_selectable_target_portrait_widget = {
								datacontext = "[Scope.Char]"

								blockoverride "onclick" {
									onclick = "[GetScriptedGui('qpq_ui_pick_char_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Character.MakeScope ).End )]"
									down = "[ObjectsEqual( GetPlayer.MakeScope.Var('qpq_ui_i_pick_char').Char, Character.Self )]"
								}
							}
						}
					}
					text_single = {
						visible = "[And( GetScriptedGui('qpq_ui_needs_char_target_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), IsDataModelEmpty( GetPlayer.MakeScope.GetList('qpq_ui_i_candidates') ) )]"
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_NO_CANDIDATES"
					}
					vbox = {
						visible = "[GetScriptedGui('qpq_ui_needs_title_target_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_title_candidates')]"

						item = {
							button_standard_list = {
								layoutpolicy_horizontal = expanding
								size = { 0 34 }
								text = "[Scope.Title.GetNameNoTooltip]"
								onclick = "[GetScriptedGui('qpq_ui_pick_title_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Scope.Title.MakeScope ).End )]"
								down = "[ObjectsEqual( GetPlayer.MakeScope.Var('qpq_ui_i_target_title').Title, Scope.Title )]"
							}
						}
					}
					vbox = {
						visible = "[GetScriptedGui('qpq_ui_needs_artifact_target_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList('qpq_ui_i_artifact_candidates')]"

						item = {
							button_standard_list = {
								layoutpolicy_horizontal = expanding
								size = { 0 34 }
								text = "[Scope.Artifact.GetName]"
								onclick = "[GetScriptedGui('qpq_ui_pick_artifact_i').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'qpq_pick', Scope.Artifact.MakeScope ).End )]"
								down = "[ObjectsEqual( GetPlayer.MakeScope.Var('qpq_ui_i_target_artifact').Artifact, Scope.Artifact )]"
							}
						}
					}
					vbox = {
						visible = "[GetScriptedGui('qpq_ui_has_extras_i').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						layoutpolicy_horizontal = expanding
						margin = { 10 8 }
						spacing = 4

						background = {
							using = Background_Area_Dark
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "QPQ_UI_EXTRAS_HEADER"
							default_format = "#T"
						}

						button_checkbox_label = {
							visible = "[GetScriptedGui('qpq_ui_extra_i_qpq_x_armed').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetScriptedGui('qpq_ui_extra_i_qpq_x_armed').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "qpq_x_armed_desc"
							blockoverride "checkbox" {
								checked = "[GetPlayer.MakeScope.Var('qpq_ui_i_qpq_x_armed').IsSet]"
							}
							blockoverride "text" {
								text = "qpq_x_armed"
							}
						}

						button_checkbox_label = {
							visible = "[GetScriptedGui('qpq_ui_extra_i_qpq_x_consent').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetScriptedGui('qpq_ui_extra_i_qpq_x_consent').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "qpq_x_consent_desc"
							blockoverride "checkbox" {
								checked = "[GetPlayer.MakeScope.Var('qpq_ui_i_qpq_x_consent').IsSet]"
							}
							blockoverride "text" {
								text = "qpq_x_consent"
							}
						}

						button_checkbox_label = {
							visible = "[GetScriptedGui('qpq_ui_extra_i_qpq_x_armies').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							onclick = "[GetScriptedGui('qpq_ui_extra_i_qpq_x_armies').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							tooltip = "qpq_x_armies_desc"
							blockoverride "checkbox" {
								checked = "[GetPlayer.MakeScope.Var('qpq_ui_i_qpq_x_armies').IsSet]"
							}
							blockoverride "text" {
								text = "qpq_x_armies"
							}
						}

					}
				}

				vbox = {
					visible = "[GetVariableSystem.HasValue( 'qpq_popup', 'gold_me' )]"
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }
					spacing = 6

					background = {
						using = Background_Area_Dark
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "QPQ_UI_GOLD_HEADER"
						default_format = "#T"
						using = Font_Size_Medium
					}
					text_multi = {
						layoutpolicy_horizontal = expanding
						max_width = 480
						autoresize = yes
						text = "QPQ_UI_GOLD_INFO_T"
					}
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4

							button_standard_list = {
								size = { 64 30 }
								text = "-1000"
								onclick = "[GetScriptedGui('qpq_ui_gold_down_t_1000').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

							button_standard_list = {
								size = { 64 30 }
								text = "-100"
								onclick = "[GetScriptedGui('qpq_ui_gold_down_t_100').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

							button_standard_list = {
								size = { 64 30 }
								text = "-10"
								onclick = "[GetScriptedGui('qpq_ui_gold_down_t_10').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								align = center|nobaseline
								text = "QPQ_UI_GOLD_AMOUNT_T"
								using = Font_Size_Medium
							}

							button_standard_list = {
								size = { 64 30 }
								text = "+10"
								onclick = "[GetScriptedGui('qpq_ui_gold_up_t_10').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

							button_standard_list = {
								size = { 64 30 }
								text = "+100"
								onclick = "[GetScriptedGui('qpq_ui_gold_up_t_100').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

							button_standard_list = {
								size = { 64 30 }
								text = "+1000"
								onclick = "[GetScriptedGui('qpq_ui_gold_up_t_1000').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

