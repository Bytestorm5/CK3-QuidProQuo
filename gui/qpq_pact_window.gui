							layoutpolicy_horizontal = expanding
							margin = { 6 4 }
							text = "qpq_hub.group.war"
							default_format = "#T"
							using = Font_Size_Medium
						}

						button_standard_list = {
							visible = "[GetScriptedGui('qpq_ui_kind_chartered_conquest').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
							layoutpolicy_horizontal = expanding
							size = { 0 32 }
							text = "qpq_chartered_conquest_name"
							tooltip = "qpq_chartered_conquest_hub_tt"
							using = tooltip_ne
							onclick = "[GetScriptedGui('qpq_ui_kind_chartered_conquest').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
