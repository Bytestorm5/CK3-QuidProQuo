				# Your authority over them: only for someone under you in your realm
				vbox = {
					visible = "[GetScriptedGui('qpq_ui_command_shown').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var('qpq_ui_recipient').Char.MakeScope ).End )]"
